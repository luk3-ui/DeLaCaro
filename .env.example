# ============================================================
# Frontend (React / Vite) — POS web
# ============================================================
VITE_SUPABASE_URL=https://gbwadnzelsuzrmtmjumi.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-o-publishable-key

# ============================================================
# N8N — Automatización + IA
# ============================================================
N8N_HOST=localhost
N8N_PROTOCOL=http
# Base URL interna de N8N (sin /webhook/...) — usada por el contenedor n8n
N8N_BASE_URL=http://n8n:5678/
# URL completa donde Evolution POSTea mensajes
N8N_WEBHOOK_URL=http://n8n:5678/webhook/whatsapp-incoming
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambiar-esta-clave

# ============================================================
# Evolution API — WhatsApp
# ============================================================
EVOLUTION_API_KEY=genera-una-clave-segura-larga
EVOLUTION_PORT=8081
EVOLUTION_SERVER_URL=http://localhost:8081
EVOLUTION_INSTANCE=comercio-ia

# Si WhatsApp queda en "connecting", probá esta versión (actualizar cada meses)
CONFIG_SESSION_PHONE_VERSION=2.3000.1040081378

# ============================================================
# OpenAI — bot WhatsApp (N8N lee esta variable)
# https://platform.openai.com/api-keys
# ============================================================
OPENAI_API_KEY=sk-proj-...

# Supabase service_role — SOLO para N8N (nunca en frontend)
# Project Settings → API Keys → Secret key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Evolution usa Postgres LOCAL en Docker (ver docker-compose.yml).
# No configurar EVOLUTION_DATABASE_URL para el stack local.

# ============================================================
# OpenAI — configurar OPENAI_API_KEY arriba para workflow 03
# ============================================================

# ============================================================
# VPS (cuando migres al KVM) — reemplazar localhost por tu dominio
# ============================================================
# N8N_HOST=n8n.tudominio.com
# N8N_PROTOCOL=https
# N8N_WEBHOOK_URL=https://n8n.tudominio.com/
# EVOLUTION_SERVER_URL=https://wa.tudominio.com
